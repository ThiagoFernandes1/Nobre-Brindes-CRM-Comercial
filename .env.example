# Copie para .env (não vai para o git). Valores só para desenvolvimento local.

# Postgres (docker-compose)
POSTGRES_USER=nobre
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=nobre_crm
POSTGRES_PORT=5433

# API
API_PORT=3333
DATABASE_URL=postgres://nobre:troque-esta-senha@localhost:5433/nobre_crm
# banco dos testes de integração (o docker-compose já cria)
DATABASE_URL_TEST=postgres://nobre:troque-esta-senha@localhost:5433/nobre_crm_test

# "Hoje" usado nas regras. Os dados do case são de 15/10/2026. Vazio = data real.
REFERENCE_DATE=2026-10-15

# Se preenchida, a API exige o header x-api-key (o proxy do Next envia)
API_KEY=

CORS_ORIGIN=http://localhost:3000

# Intervalo do job de follow-up dentro da API, em minutos (0 desliga)
FOLLOW_UP_JOB_INTERVAL_MINUTES=15
# Webhook opcional (Slack, Teams, n8n) para o resumo diário dos vendedores
FOLLOW_UP_WEBHOOK_URL=
