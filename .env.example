# Copie para .env (nunca versionado). Valores abaixo são apenas para desenvolvimento local.

# --- PostgreSQL (usado pelo docker-compose) ---
POSTGRES_USER=nobre
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=nobre_crm
POSTGRES_PORT=5433

# --- API ---
API_PORT=3333
DATABASE_URL=postgres://nobre:troque-esta-senha@localhost:5433/nobre_crm
# Banco separado usado só pelos testes de integração (criado automaticamente pelo docker-compose)
DATABASE_URL_TEST=postgres://nobre:troque-esta-senha@localhost:5433/nobre_crm_test

# Data de "hoje" para as regras de atenção/follow-up. Os dados fictícios do case são de 15/10/2026.
# Deixe vazio para usar a data real (fuso America/Sao_Paulo).
REFERENCE_DATE=2026-10-15

# Se definida, toda requisição precisa do header x-api-key. O front envia pelo proxy do Next (lado servidor).
API_KEY=

# Origem liberada no CORS (só relevante se o navegador chamar a API direto, sem o proxy do Next)
CORS_ORIGIN=http://localhost:3000

# Automação de follow-up: intervalo do job dentro do processo da API (0 desliga)
FOLLOW_UP_JOB_INTERVAL_MINUTES=15
# Opcional: URL de webhook (Slack/Teams/n8n) para receber o resumo diário de retornos por vendedor
FOLLOW_UP_WEBHOOK_URL=
